{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 1200
    },
    "highlights": {
      "default": [],
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "stack": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "product",
        "ai",
        "service",
        "tool",
        "web",
        "early"
      ]
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "wip",
        "stable",
        "archived"
      ]
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "order": {
      "default": 500,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "display": {
      "type": "boolean"
    },
    "publicSafe": {
      "default": false,
      "type": "boolean"
    },
    "links": {
      "default": {},
      "type": "object",
      "properties": {
        "site": {
          "type": "string",
          "format": "starts_with",
          "pattern": "^https:\\/\\/.*"
        },
        "source": {
          "type": "string",
          "format": "starts_with",
          "pattern": "^https:\\/\\/.*"
        },
        "download": {
          "type": "string",
          "format": "starts_with",
          "pattern": "^https:\\/\\/.*"
        },
        "package": {
          "type": "string",
          "format": "starts_with",
          "pattern": "^https:\\/\\/.*"
        }
      },
      "additionalProperties": false
    },
    "year": {
      "type": "integer",
      "minimum": 2015,
      "maximum": 2100
    },
    "packages": {
      "type": "object",
      "properties": {
        "npm": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pypi": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  },
  "required": [
    "slug",
    "name",
    "tagline",
    "category",
    "status",
    "display"
  ],
  "additionalProperties": false,
  "$id": "https://tochi-mba.github.io/schema/project.schema.json",
  "title": "Portfolio project metadata",
  "description": "What a repository says about itself to https://tochi-mba.github.io/. Kept in .portfolio/project.json; the portfolio publishes it only when display is true, and a private repository only when publicSafe is true as well."
}
